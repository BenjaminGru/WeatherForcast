# MSBuild Binär- und Strukturiertes Protokoll
*.binlog

# NVidia Nsight GPU-Debugger-Konfigurationsdatei
*.nvuser

# MFractors (Xamarin Produktivitätstool) Arbeitsordner
.mfractor/

# Lokale Geschichte für Visual Studio
.lokalgeschichte/

# Visual Studio Verlaufsdateien (VSHistory)
.vshistory/

# BeatPulse-Gesundheitscheck-Temporärdatenbank
healthchecksdb

# Sicherungsordner für das Tool „Paketreferenzkonvertierung“ in Visual Studio 2017
MigrationBackup/

# Ionide (plattformübergreifende F# VS Code-Tools) Arbeitsordner
.ionid/

